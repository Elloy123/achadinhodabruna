# Copie para .env e preencha
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Mercado Pago -> https://www.mercadopago.com.br/developers/panel/app
# Use as credenciais de TESTE (TEST-...) até validar tudo; depois troque pelas de produção (APP_USR-...)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Segredo da assinatura do webhook (Suas integrações > Webhooks). Opcional, mas recomendado.
MERCADOPAGO_WEBHOOK_SECRET=

# Endereço público do site (https em produção). Usado nos retornos e no webhook do MP.
SITE_URL=http://127.0.0.1:8000

# Loja
TAXA_ENTREGA=5.00
ENDERECO_RETIRADA=Centro, Rurópolis - PA (combinar pelo WhatsApp)
# Só números, com DDI e DDD. Ex.: 5593900000000
WHATSAPP_LOJA=
